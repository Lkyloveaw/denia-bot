# ===================== NoneBot2 驱动 =====================
DRIVER=~fastapi+~websockets+~httpx
# 本机部署填 127.0.0.1；容器/远程部署才填 0.0.0.0，并务必在防火墙/反代后
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# ===================== OneBot v11 鉴权 =====================
# SnowLuma 侧 wsClients 的 accessToken 必须与此一致
# 生成一个强的：python -c "import secrets;print(secrets.token_urlsafe(32))"
ONEBOT_ACCESS_TOKEN=请替换成随机长串

# ===================== NoneBot 基础 =====================
# 超级管理员 QQ 号：只作为首次的初始名单。
# 机器人启动后会改用 data/superusers.json；面板「超级管理员」里保存过一次就
# 以面板为准，这里不再生效。
SUPERUSERS=["你的QQ号"]
COMMAND_START=["."]

# ===================== MuiceBot =====================
# 响应昵称前缀：消息以这些词开头时响应（无需 @）
MUICE_NICKNAMES=["达妮娅", "小娅", "娅"]
# 最大记忆历史轮数，0 = 不限制
MAX_HISTORY_EPOCH=20
# 思考模型的处理模式：0=不处理 1=提取思考与结果 2=仅输出结果
THOUGHT_PROCESS_MODE=2
# 消息合并等待（秒），0 = 不合并
INPUT_TIMEOUT=0
ENABLE_BUILTIN_PLUGINS=true
# 默认人格模板（对应 templates/ 下的文件名，不含 .jinja2）
DEFAULT_TEMPLATE=Denia

# ===================== 自家插件 prompt_guard（署名规范化）=====================
# 0 = 完全不动提示词（群名片会重新被当成话题），改完要重启
PROMPT_GUARD=1
# 0 = 历史不按场景筛：别的群、别的私聊说过的话照旧带进本轮（回滚用，不用改代码）
PROMPT_GUARD_ISOLATE=1

# ===================== 自家插件 quote_fix（引用回复补丁）=====================
# 0 = 不打补丁：QQ 的「回复」会崩在 muicebot/onebot.py:624（UniMessage 收下框架原生
#     MessageSegment），表现为「已读不回」。补丁把被引用的那条渲染成
#     〔发言人:某某〕+ 换行 + 正文 的纯文本，顺便让主人在人格里对得上称呼。改完要重启
QUOTE_FIX=1

# ===================== 自家插件 gate：引用带的 @ 算不算 =====================
# QQ 点「回复」时会替被引用的那个人自动补一个 @。1 = 那也算在 @ 她。
# 0 = 收紧：那不算，要她回话得自己再 @ 一次（主人不受这条影响）。改完要重启
QUOTE_AT_COUNTS=1

# ===================== 自家插件 model_pref（回话用哪个模型）=====================
# 0 = 只留 `.模型` 指令换首选/次选，永不自动降级：首选坏了就回到「已读不回」。
#     主人私聊发：模型 查看 ｜ 模型 首选 <条目名> ｜ 模型 次选 <条目名|无>
MODEL_FAILOVER=1
# 等第一个字最多几秒。中转站最常见的坏法是「挂住不报错」，没有超时永远等不到降级那一刻。
MODEL_FAILOVER_TIMEOUT=45

# ===================== 自家插件 image_guard（看图）=====================
# 0 = 不看图：图片在进模型前被丢掉（回滚用）；1 = 让模型直接看。
# 还要配合 configs/models.yml 当前条目的 `multimodal: true`，少一个都不生效。改完要重启
IMAGE_VISION=1
# 图片最长边压到多少像素再送模型。越大越清楚，token 越多
IMAGE_MAX_SIDE=1280
# 一条消息最多带几张图，多的丢掉
IMAGE_MAX_COUNT=4

# ===================== 自家插件 game_events（活动封面网络）=====================
# 默认 system 使用系统 DNS。网络返回 198.18.x.x Fake-IP 时，可选 google 使用 Google DoH。
# 只影响活动封面；两种模式都拒绝非公网地址并校验原域名 TLS。修改后重启机器人。
GAME_EVENT_COVER_DNS=system
